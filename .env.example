# ── App ──────────────────────────────────────────────────────────
# APP_ENV: development | staging | production
APP_ENV=development
APP_PORT=3001
# APP_LOG_LEVEL: debug | info | warn | error
APP_LOG_LEVEL=debug
# APP_LOG_FORMAT: text (dev) | json (prod)
APP_LOG_FORMAT=text
# MIN_APP_VERSION: versión MÍNIMA de la app móvil que el API acepta (nombre,
# p. ej. 2.17.0). Vacío = sin bloqueo. Es el respaldo del bloqueo en la app.
# Encender SÓLO después de publicar la app; un valor equivocado deja fuera a
# toda la flota, y vaciarlo lo revierte igual de rápido. Los clientes que no
# mandan X-App-Version (escritorio, web, v1) pasan siempre.
MIN_APP_VERSION=

# ── Firebird (single source of truth — Microsip + nuestras tablas MSP_*) ─
FB_HOST=localhost
FB_PORT=3050
FB_DATABASE=/firebird/data/MUEBLERA.FDB
FB_USER=SYSDBA
FB_PASSWORD=masterkey
# Charset: UTF8 lets the Firebird server transcode strings so Go stays
# UTF-8 native end to end. Switch to WIN1252 only when debugging parallel
# writes against the legacy Node API or a server pinned to WIN1252.
FB_CHARSET=UTF8
FB_POOL_SIZE=10
FB_WIRE_CRYPT=true
FB_WIRE_COMPRESS=false
# Server-side ceiling applied to every connection via SET STATEMENT TIMEOUT.
# It is a guard against hung statements, not a per-request SLA: background
# reconciles legitimately run for minutes. 0 disables the SET.
FB_STATEMENT_TIMEOUT=10m

# ── Firebase (autenticación) ─────────────────────────────────────
# Conditional gating (see internal/platform/config Firebase docs):
#   APP_ENV=production                         → FIREBASE_PROJECT_ID required.
#   APP_ENV=development + DEV_MODE=true        → FIREBASE_PROJECT_ID optional;
#                                                "dev:<uid>" tokens accepted.
#   anything else                              → required unless
#                                                ALLOW_UNCONFIGURED=true.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Development-only: accept "dev:<uid>[:<email>]" bearer tokens without
# verifying with Firebase. Refused outside APP_ENV=development.
#
# Defaults to true ON PURPOSE. This template must produce a working setup on
# a fresh clone, and with DEV_MODE=false + an empty FIREBASE_PROJECT_ID the
# config fails to load — which surfaces as tests failing in packages that
# never touch Firebase (they only call config.Load()). Two developers lost
# time to exactly that.
#
# It costs nothing in safety: config.validate refuses DEV_MODE outside
# APP_ENV=development, so this cannot leak into staging or production.
#
# Set it to false and fill in FIREBASE_PROJECT_ID (plus a real
# serviceAccountKey.json) only when you need to exercise the actual Firebase
# login flow — working against the Go API does not require it.
FIREBASE_DEV_MODE=true
# Escape hatch: boot with the NotConfigured client so every authenticated
# request returns 401. Use only for staging/internal-tooling deployments.
FIREBASE_ALLOW_UNCONFIGURED=false
# Web API key del proyecto Firebase (Settings → General → Web API Key).
# Lo usan probes/seed scripts para canjear UID → ID token vía signInWithCustomToken.
# No es secreto en el sentido de service-account, pero pertenece a este proyecto.
FIREBASE_WEB_API_KEY=
# Email del usuario admin bootstrap (debe existir en Firebase Auth y en MSP_USUARIOS).
# Lo usan probes/seed scripts para autenticarse como admin.
ADMIN_EMAIL=
# Firebase Auth Emulator (solo para tests integration; ver docs/firebase-setup.md).
# Cuando está set, el SDK redirige tráfico al emulador en lugar de Google.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── Sync Microsip → Postgres ─────────────────────────────────────
MICROSIP_SYNC_ENABLED=true
MICROSIP_SYNC_INTERVAL=5s
MICROSIP_SYNC_BATCH_SIZE=500

# ── Microsip catalog (read-only /v2/almacenes, /v2/zonas-cliente) ─
# Lista de PRECIO_EMPRESA_IDs filtrada por el endpoint de artículos
# por almacén. Cambiar sin recompilar si cambian las listas de precios.
MICROSIP_PRICE_LIST_IDS=42,8437,6925

# ── Observabilidad ───────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=msp-api

# ── HTTP ─────────────────────────────────────────────────────────
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_SIZE_MB=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Failed-intent capture (see internal/platform/failedintent + ADR-0005) ───
# Retention window for captured 4xx/5xx requests. The janitor purges rows
# older than this. Default: 90 days.
FAILED_INTENT_RETENTION_DAYS=90

# Maximum bytes of the request body captured per intent. Bodies larger than
# this are truncated and Intent.BodyTruncated is set to true. Default: 262144
# (256 KiB).
FAILED_INTENT_BODY_CAP_BYTES=262144

# Directory for multipart-body blobs captured by the failedintent middleware.
# Defaults to STORAGE_DIR/failed-intents when unset. Each blob is 0o600 and
# named after the intent UUID.
FAILEDINTENT_BLOB_DIR=

# Hard cap (in bytes) per multipart blob. Requests whose body exceeds this
# are still captured as intents but with BodyBlobPath="" and BodyTruncated=true.
# Default: 52428800 (50 MiB).
FAILEDINTENT_MAX_MULTIPART_BYTES=52428800

# ── Microsip venta (writer knobs) ───────────────────────────────
# LIBRES_CARGOS_CC.TIEMPO_A_CORTO_PLAZOMESES escrito en ventas a crédito.
# Default: 4.
MICROSIP_TIEMPO_CORTO_PLAZO_MESES=4
# FORMA_COBRO_ID ligado al documento de enganche vía FORMAS_COBRO_DOCTOS.
# Default: 157 (el valor de los enganches reales en el ledger de producción).
MICROSIP_FORMA_COBRO_ENGANCHE=157
# LIMITE_CREDITO que se asienta en el nuevo cliente auto-creado por AplicarVenta.
# Default: 10000.
MICROSIP_CLIENTE_LIMITE_CREDITO=10000
# Activar la resolución combo → juego (kit Microsip) dentro de AplicarVenta.
# Cuando está en true, cada combo de la venta se mapea a un ARTICULO con ES_JUEGO='S'
# y el writer emite líneas ROL='J' + ROL='C' en lugar de aplanar los productos.
MICROSIP_VENTA_JUEGOS_ENABLED=false
# LINEA_ARTICULO_ID que se asigna a los juegos creados por el JuegoResolver.
# Requerido (> 0) cuando MICROSIP_VENTA_JUEGOS_ENABLED=true.
MICROSIP_VENTA_JUEGOS_LINEA_ARTICULO_ID=0
# Reactivar en Microsip (ESTATUS 'B' -> 'A') al cliente de una venta de CRÉDITO
# cuando esté dado de baja, en la misma transacción del apply. Solo CRÉDITO;
# CONTADO nunca reactiva. Default: false.
MICROSIP_REACTIVAR_CLIENTE_ENABLED=false
# Exigir zona en TODA venta y resolver caja/cajero desde MSP_CFG_ZONA_CAJA
# también para CONTADO (hoy usa la caja fija de MSP_CFG_APLICAR).
# Encender SÓLO cuando la adopción de la app que exige zona sea ~total Y toda
# zona activa tenga fila en MSP_CFG_ZONA_CAJA — una zona sin fila hace fallar
# sus ventas con zona_sin_caja. Default: false (drena el rezago sin zona).
VENTAS_ZONA_OBLIGATORIA=false
# Resolver la ciudad capturada contra el catálogo CIUDADES de Microsip al dar
# de alta un cliente, en vez de escribir siempre Tehuacán/Puebla. Una ciudad
# sin coincidencia BLOQUEA el aplicar (no cae al default).
# Encender SÓLO tras depurar el catálogo: tiene casi-duplicados
# (TLACHICHUCA / TLACHICHUCA, PUE) y filas cuyo ESTADO_ID contradice al nombre
# (QUERETARO, TECAMAC y TECAMACHALCO están bajo CIUDAD DE MEXICO).
VENTAS_CIUDAD_CATALOGO=false

# ── Inventario (Microsip traspaso knobs) ─────────────────────────
# IDs Microsip usados por el módulo inventario al crear traspasos y
# resolver el almacén de venta. Coinciden con la API legacy Node.
# Cambiarlos requiere coordinación — ver docs/ops/inventario-cutover.md.
INVENTARIO_ALMACEN_DESTINO_VENTAS_ID=11058
INVENTARIO_CONCEPTO_IN_SALIDA_ID=36
INVENTARIO_CONCEPTO_IN_ENTRADA_ID=25
INVENTARIO_SUCURSAL_ID=225490

# ── Storage (ventas blobs) ───────────────────────────────────────
# Image uploads are written under STORAGE_DIR on local disk. The
# on-prem Windows Server deploy uses a directory served from a fixed
# path on the file system.
STORAGE_DIR=./var/uploads

# ── Image processor (server-side resize + recompress) ────────────
# The processor decodes incoming image uploads, caps the long side at
# MAX_LONG_SIDE_PX, and re-encodes with JPEG quality JPEG_QUALITY.
# Disable to make uploads pass through verbatim (NoOp impl).
IMAGEPROCESSOR_ENABLED=true
IMAGEPROCESSOR_MAX_LONG_SIDE_PX=1920
IMAGEPROCESSOR_JPEG_QUALITY=85
# png.CompressionLevel: -1 default, 0 no compression, -2 best speed, -3 best compression
IMAGEPROCESSOR_PNG_COMPRESSION=-1
# Hard cap on the source body. Uploads above this are rejected before decode.
IMAGEPROCESSOR_MAX_INPUT_BYTES=15728640
# Re-encode WebP inputs as JPEG (golang.org/x/image/webp is decode-only).
IMAGEPROCESSOR_WEBP_TO_JPEG=true
# Skip decode+encode when the input is already compact (size + dimensions fit).
IMAGEPROCESSOR_PRESERVE_SMALL=true
IMAGEPROCESSOR_SMALL_IMAGE_BYTES=524288

# ── Meilisearch (clientes directory search) ─────────────────────
# Full-text search engine for the clientes hub directory.
# Dev: start with `make meilisearch-up` (http://localhost:7700, no auth).
# Prod: run meilisearch.exe via nssm on Windows Server; set a master key.
#
# Conditional gating (see internal/platform/config Meilisearch docs):
#   APP_ENV=production              → MEILISEARCH_URL required.
#   any other env                  → required unless
#                                    MEILISEARCH_ALLOW_UNCONFIGURED=true.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
# UID of the clientes Meilisearch index. Change only when migrating indexes.
MEILISEARCH_INDEX_NAME=clientes
# UID of the ventas Meilisearch index. Change only when migrating indexes.
MEILISEARCH_VENTAS_INDEX_NAME=ventas
# How often the background reconcile worker syncs Firebird → Meilisearch.
MEILISEARCH_SYNC_INTERVAL=5m
# Escape hatch: boot with the NotConfigured client so search calls return
# ErrMeilisearchNotConfigured. Use only for envs where search is not needed.
MEILISEARCH_ALLOW_UNCONFIGURED=false

# ── Flota: bitácora de asignaciones de camioneta ───────────────────────────
# El worker fotografía la colección `users` de Firestore y compara valores para
# detectar quién cambió de camioneta. No se puede usar el update_time de
# Firestore: la app reescribe FECHA_VERSION_APP en cada apertura y lo ensucia.
#
# Cada pasada cuesta UNA lectura de Firestore por documento del padrón (62 hoy).
# A 15m son ~5,950 lecturas/día, ~12% de la capa gratuita de 50,000/día.
# A 5m serían ~17,900/día (36%), que no vale cuatro veces la resolución.
FLOTA_SNAPSHOT_INTERVAL=15m
# Interruptor de apagado. Aunque esté en true, el worker NO arranca si Firebase
# no está configurado o está en modo dev: no hay padrón que fotografiar.
FLOTA_SNAPSHOT_ENABLED=true

# ── LLM local (Ollama dev / llama-server prod) — apagado por defecto ────────
# Arrancar: `docker compose up -d ollama` y luego
# `docker exec msp-ollama ollama pull qwen3:4b`.
# URL cuando la API corre en el host (caso normal):
#   LLM_BASE_URL=http://localhost:11434/v1
# URL cuando la API corre dentro de compose:
#   LLM_BASE_URL=http://ollama:11434/v1
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT=30s

# ── Canal: buzón de WhatsApp (ADR 0009, módulo sellado) ──────────
# Cliente de la WhatsApp Cloud API de Meta (internal/platform/whatsapp).
# Enabled en false por defecto: sin credenciales no se intenta ninguna
# conexión de red. Ver docs/adr/0010-whatsapp-cloud-api-and-the-always-on-edge.md.
WHATSAPP_ENABLED=false
# Token de acceso (permanente o de larga duración) del System User de Meta.
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# phone_number_id de la Graph API para el número que envía/recibe.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# id de la WhatsApp Business Account (WABA).
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
# App secret de la app de Meta; valida la firma HMAC del webhook
# (X-Hub-Signature-256) contra los bytes crudos del cuerpo, antes de
# parsear JSON.
WHATSAPP_APP_SECRET=0123456789abcdef0123456789abcdef
# Versión de la Graph API usada en cada endpoint.
WHATSAPP_API_VERSION=v21.0
# Timeout por llamada a la Graph API. Default: 15s.
WHATSAPP_TIMEOUT=15s
# Override de la URL base de la Graph API. Vacío usa el default real
# (https://graph.facebook.com) — sólo se pone en pruebas, que apuntan esto a
# un httptest.Server; no se toca en producción.
WHATSAPP_BASE_URL=
# Token que Meta manda de vuelta en la verificación GET del webhook
# (hub.verify_token). Cadena elegida por nosotros, no la emite Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify-token

# ── Reactivación: canal de envío ─────────────────────────────────
# Selecciona el MessageSender de internal/reactivacion: "fake" (default,
# simula el envío y nunca toca un número real) o "cloudapi" (canal real
# sobre la WhatsApp Cloud API de Meta, reutiliza la sección WHATSAPP_*
# de arriba — requiere WHATSAPP_ENABLED=true con credenciales válidas).
# Cualquier otro valor cae también a "fake": es el default seguro.
REACTIVACION_SENDER=fake

# 🔴 cmd/winback (el binario del VPS) también arranca por config.Load()
# (internal/platform/config), y ese validate() es compartido con cmd/api —
# no se toca aquí, es pre-existente y afecta a todo el repo. Con
# APP_ENV=production, dos variables NO relacionadas con canal son
# obligatorias sin escape hatch aunque winback nunca las toque:
#   - FIREBASE_PROJECT_ID: winback no tiene usuario Firebase (Meta
#     autentica por firma HMAC, la tienda por token compartido — ver la
#     tabla de desviaciones en global-constraints.md), pero
#     Firebase.validate() para EnvProduction retorna error si está vacío,
#     sin importar FIREBASE_ALLOW_UNCONFIGURED.
#   - MEILISEARCH_URL: winback no indexa ni busca nada, pero
#     Meilisearch.validate() para EnvProduction hace exactamente lo mismo.
# El .env de winback en el VPS debe traer un valor cualquiera (no vacío,
# no tiene que ser válido ni alcanzable) para las dos — de lo contrario
# config.Load() falla en la construcción del grafo fx y el binario nunca
# arranca. STORAGE_DIR no necesita esto: tiene envDefault y nunca es
# obligatorio.
#
# Ruta del archivo SQLite del buzón (internal/canal/infra/canalsqlite). El
# buzón es lo que permite responder 200 a Meta antes de que la tienda haya
# visto el mensaje — debe sobrevivir un reinicio del VPS.
CANAL_SQLITE_PATH=./var/canal/buzon.db

# Adaptador HTTP del puerto outbound.Forwarder (internal/canal/infra/canalhttp):
# reenvía cada entrante al servidor on-premise de la tienda, autenticado con
# un token compartido — no hay usuario Firebase de por medio. Apunta a
# POST /v2/reactivacion/tienda/mensaje-entrante (cmd/api en la tienda, Task 10).
CANAL_FORWARDER_URL=http://tienda.example.com:3001/v2/reactivacion/tienda/mensaje-entrante
# Timeout por llamada de reenvío. Default: 15s.
CANAL_FORWARDER_TIMEOUT=15s
# Secreto compartido para el tráfico interno VPS<->tienda EN AMBAS
# direcciones: protege POST /canal/v1/salientes en esta VPS (lo que la
# tienda manda) y es lo que ForwarderClient manda a la tienda al empujar un
# entrante. Un solo valor para las dos direcciones porque es la misma
# frontera de confianza — nombre correcto: no es sólo "del forwarder".
CANAL_SHARED_TOKEN=change-me-shared-token
# Lista opcional (separada por comas) de IPs permitidas para llamar a
# POST /v2/reactivacion/tienda/mensaje-entrante en cmd/api (la tienda),
# además del token compartido. Vacío (default) = filtro desactivado — es
# lo único que no rompe el desarrollo local ni la suite de pruebas. Ver el
# comentario de tiendaIPMiddleware: puede no funcionar detrás del túnel
# pinggy de la tienda; el token compartido es la frontera real.
CANAL_TIENDA_ALLOWED_IPS=

# Puerto HTTP de cmd/winback (binario aparte, corre en el VPS Linux — no en
# el Windows Server 2016 donde corre cmd/api).
WINBACK_PORT=8090

# ── Tests ────────────────────────────────────────────────────────
# Firebird-backed integration tests gate on FB_DATABASE (same value as the
# main app uses above). Set the var and run `make test-firebird-all` to
# exercise the platform + module integration suites against the dev
# Firebird container. Per ADR-0008 there is no separate test-DB target —
# `fbtestutil.WithTestTransaction` wraps every integration test in a
# rollback-only transaction so the shared dev DB never accumulates state.
